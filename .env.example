# Copia este archivo como ".env" y cambia los valores.
# El archivo ".env" real NUNCA se sube a GitHub (está en .gitignore).

# Contraseña del usuario "sa" de SQL Server.
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
SA_PASSWORD=CambiaEstaClave123!

# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres).
JWT_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas-caracteres

# Opcionales (tienen valor por defecto en docker-compose.yml)
# JWT_ISSUER=ventas-api
# JWT_AUDIENCE=ventas-clientes
# ALLOWED_ORIGINS=http://localhost:4200
